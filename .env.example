# Copy this file to ".env" and fill it in on YOUR machine or server only.
# The real ".env" file is blocked from GitHub by .gitignore. Never paste real
# keys or passwords into this example file.

# Where the server listens. 127.0.0.1 means "only this computer".
HOST=127.0.0.1
PORT=3000

# SAFETY SWITCH. While this is "dry-run" the app can NEVER send a real email.
# Real sending is not built yet and needs your explicit approval first.
SEND_MODE=dry-run

# Where the database file lives (sample data only until you approve real data).
DATABASE_PATH=data/outreach.db

# Added in later stages, only after you approve them:
# ANTHROPIC_API_KEY=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
